# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal chat ID. Send /start to your bot once to get it,
# then paste it here and restart the bot.
TELEGRAM_CHAT_ID=

# Optional: ntfy.sh topic for an extra loud phone push notification
# (create any private/unguessable topic name on https://ntfy.sh)
NTFY_TOPIC=

# Optional: seconds between each check (default: 2)
CHECK_INTERVAL=2

# Optional: base CROUS search URL for the current campaign.
# CROUS changes the numeric tool id every academic year — if the bot stops
# finding results, open https://trouverunlogement.lescrous.fr, start a
# search, and copy the "/tools/<id>/search" part from the resulting URL.
CROUS_SEARCH_BASE_URL=https://trouverunlogement.lescrous.fr/tools/47/search